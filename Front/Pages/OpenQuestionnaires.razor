@page "/openquestionnaires"
@using Front.Components.OpenQuestionnaire
@inject HttpClient Http
@inject JsonSerializerSettings jsonSettings

<PageTitle>Open Questionnaires</PageTitle>

@if (_OpenQuestionnaires == null)
{
    <Spinner Class="me-3" Type="SpinnerType.Dots" Color="SpinnerColor.Success" Size="SpinnerSize.ExtraLarge" />
}
else
{
    <div class="container" style="max-width:1600px">
        <div class="row">
            @foreach (var openQuestionnaire in _OpenQuestionnaires)
            {
                <div class="col">
                    <OpenQuestionnaireCardComponent _OpenQuestionnaire="@openQuestionnaire" OnOpenQuestionnaireDelete="DeleteOpenQuestionnaire" />
                </div>
            }
        </div>
    </div>
}

@code {
    List<OpenQuestionnaire>? _OpenQuestionnaires;

    protected override async Task OnInitializedAsync()
    {
        var response = await Http.GetAsync("OpenQuestionnaire");
        response.EnsureSuccessStatusCode();
        var jsonString = await response.Content.ReadAsStringAsync();
        _OpenQuestionnaires = JsonConvert.DeserializeObject<List<OpenQuestionnaire>>(jsonString, jsonSettings);
    }

    private void DeleteOpenQuestionnaire(string openQuestionnaireId)
    {
        var openQuestionnaireToRemove = _OpenQuestionnaires.Where(o => o.Id == openQuestionnaireId).First();

        if (openQuestionnaireToRemove != null)
        {
            _OpenQuestionnaires.Remove(openQuestionnaireToRemove);
        }
    }
}
