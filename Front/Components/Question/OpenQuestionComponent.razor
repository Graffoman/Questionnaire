
<Card Style="width:40rem;margin:10px">
    <CardHeader Class="mb-2 text-muted">
        @switch (_Question.Type)
        {
            case QuestionType.MultipleSelect:
                <div>Можете выбрать несколько вариантов ответа </div>
                break;
            case QuestionType.Select:
                <div>Можете выбрать лишь один вариант ответа </div>
                break;
            case QuestionType.IntRange:
                <div>Нужно выбрать диапазон в рамках </div>
                break;
            case QuestionType.Checkbox:
                <div>Нужно поставить галочку если ответ "Да" </div>
                break;
            default:
                <div>Дайте ответ в свободной форме </div>
                break;
        }
    </CardHeader>
    <CardBody>
        <CardText>@_Question.QuestionText</CardText>

        @switch (_Question.Type)
        {
            case QuestionType.MultipleSelect:
                <div>
                    @for (int i = 0; i < Options.Count(); i++)
                    {
                        var iCopy = i;

                        <div style="display: flex">
                            <InputText disabled class="form-control" Style="margin:5px 10px 5px 0" @bind-Value="@Options[iCopy]">@Options[iCopy]</InputText>
                            <input type="checkbox" @onclick="() => AddOrDeleteOptionInAnswersList(Options[iCopy])" />
                        </div>
                    }
                </div>
                break;
            case QuestionType.Select:
                <div>
                    @for (int i = 0; i < Options.Count(); i++)
                    {
                        var iCopy = i;

                        <div style="display: flex">
                            <InputText disabled class="form-control" Style="margin:5px 10px 5px 0" @bind-Value="@Options[iCopy]">@Options[iCopy]</InputText>
                            <input type="checkbox" @onclick="() => SetOptionAsAnswer(Options[iCopy])" />
                        </div>
                    }
                </div>
                break;
            case QuestionType.IntRange:
                <div>
                    <div class="mb-3">
                        <NumberInput TValue="int" @bind-Value="@(((QuestionIntRange)_Question).Answer.From)" Placeholder="Введите минимальное значение" />
                        <span class="form-text">Минимальное значение: @(((QuestionIntRange)_Question).Limits.From)</span>
                    </div>

                    <div class="mb-3">
                        <NumberInput TValue="int" @bind-Value="@(((QuestionIntRange)_Question).Answer.To)" Placeholder="Введите максимальное значение" />
                        <span class="form-text">Максимальное значение: @(((QuestionIntRange)_Question).Limits.To)</span>
                    </div>
                </div>
                break;
            case QuestionType.Checkbox:
                <InputCheckbox @bind-Value="@(((QuestionCheckbox)_Question).Answer)"></InputCheckbox>
                break;
            case QuestionType.Text:
                <InputTextArea class="form-control" rows="3" @bind-Value="@(((QuestionText)_Question).Answer)"></InputTextArea>
                break;
            default:
                break;
        }
    </CardBody>
</Card>

@code {
    [Parameter]
    public Question _Question { get; set; }

    private List<string> Options { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        switch (_Question.Type)
        {
            case QuestionType.MultipleSelect:
                Options = ((QuestionMultipleSelect)_Question).Options;
                ((QuestionMultipleSelect)_Question).Answer = new();
                break;

            case QuestionType.Select:
                Options = ((QuestionSelect)_Question).Options;
                break;
            case QuestionType.IntRange:
                ((QuestionIntRange)_Question).Answer = new
                (
                    ((QuestionIntRange)_Question).Limits.From,
                    ((QuestionIntRange)_Question).Limits.To
                );
                break;
            default:
                break;
        }
    }

    private void AddOrDeleteOptionInAnswersList(string option)
    {
        if (((QuestionMultipleSelect)_Question).Answer.Contains(option))
        {
            ((QuestionMultipleSelect)_Question).Answer.Remove(option);
        }
        else
        {
            ((QuestionMultipleSelect)_Question).Answer.Add(option);
        }
    }

    private void SetOptionAsAnswer(string option)
    {
        ((QuestionSelect)_Question).Answer = option;
    }
}
