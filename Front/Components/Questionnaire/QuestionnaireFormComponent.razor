@using AutoMapper
@using Services.Contracts.QuestionnaireDto
@inject HttpClient httpClient
@inject JsonSerializerSettings jsonSettings
@inject IMapper mapper

<QuestionnaireHeaderComponent></QuestionnaireHeaderComponent>

<Card Color="CardColor.Light" Style="width:40rem;margin:10px">
	<CardBody>
		<Dropdown Color="DropdownColor.Secondary" Size="DropdownSize.Small">
			<DropdownToggleButton>Добавить новый вопрос</DropdownToggleButton>
			<DropdownMenu>
				<DropdownItem Type="DropdownItemType.Button" @onclick="() => AddNewQuestion(QuestionType.Text)">Текстовый</DropdownItem>
				<DropdownItem Type="DropdownItemType.Button" @onclick="() => AddNewQuestion(QuestionType.Checkbox)">Чекбокс</DropdownItem>
				<DropdownItem Type="DropdownItemType.Button" @onclick="() => AddNewQuestion(QuestionType.IntRange)">Диапазон</DropdownItem>
				<DropdownItem Type="DropdownItemType.Button" @onclick="() => AddNewQuestion(QuestionType.Select)">Выбор из списка</DropdownItem>
				<DropdownItem Type="DropdownItemType.Button" @onclick="() => AddNewQuestion(QuestionType.MultipleSelect)">Множественный выбор</DropdownItem>
			</DropdownMenu>
		</Dropdown>
		<Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="InsertNewOrUpdateExistingQuestionnaire"> Сохранить опрос</Button>
		<Button Color="ButtonColor.Danger" Size="ButtonSize.Small"> Удалить опрос</Button>
	</CardBody>
</Card>

<div>
	@for(int i = 0; i < _Questionnaire.Questions.Count(); i++)
	{
		var iCopy = i;

		<QuestionComponent 
			_Question="_Questionnaire.Questions.ElementAt(iCopy)" 
			OnQuestionDelete="DeleteQuestion">
		</QuestionComponent>
	}
</div>


@code {
	[CascadingParameter]
	public Questionnaire _Questionnaire { get; set; }

	private bool IsNewQuestionnaire;

	protected override void OnInitialized()
	{
		IsNewQuestionnaire = _Questionnaire.Id == null ? true : false;
	}

	private void DeleteQuestion(string questionId)
	{
		var questionToRemove = _Questionnaire.Questions.Where(q => q.Id == questionId).First();

		if(questionToRemove != null)
		{
			_Questionnaire.Questions.Remove(questionToRemove);
		}
	}

	private void AddNewQuestion(QuestionType questionType)
	{
		switch (questionType)
		{
			case QuestionType.Text:
				_Questionnaire.Questions.Add(new QuestionText());
				break;

			case QuestionType.Checkbox:
				_Questionnaire.Questions.Add(new QuestionCheckbox());
				break;

			case QuestionType.IntRange:
				_Questionnaire.Questions.Add(new QuestionIntRange());
				break;

			case QuestionType.Select:
				_Questionnaire.Questions.Add(new QuestionSelect());
				break;

			case QuestionType.MultipleSelect:
				_Questionnaire.Questions.Add(new QuestionMultipleSelect());
				break;

			default:
				break;
		}
	}

	private async Task InsertNewOrUpdateExistingQuestionnaire()
	{
		HttpResponseMessage responseMessage;

		if (IsNewQuestionnaire)
		{
			var dto = mapper.Map<Questionnaire, CreateQuestionnaireDto>(_Questionnaire);
			var payload = JsonConvert.SerializeObject(dto, jsonSettings);
			var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
			responseMessage = await httpClient.PostAsync("Questionnaire/", content);
		}
		else
		{
			var dto = mapper.Map<Questionnaire, UpdateQuestionnaireDto>(_Questionnaire);
			var payload = JsonConvert.SerializeObject(dto, jsonSettings);
			var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
			responseMessage = await httpClient.PutAsync($"Questionnaire/{_Questionnaire.Id}", content);
		}

		if (responseMessage.IsSuccessStatusCode)
		{

		}
		else
		{
			
		}
	}
}
