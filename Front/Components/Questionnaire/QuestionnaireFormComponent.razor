
<QuestionnaireHeaderComponent></QuestionnaireHeaderComponent>

<QuestionnaireCRUDButtonsPanelComponent OnNewQuestionAdd="AddNewQuestion"></QuestionnaireCRUDButtonsPanelComponent>

<div>
	@for(int i = 0; i < _Questionnaire.Questions.Count(); i++)
	{
		var iCopy = i;

		<QuestionComponent 
			_Question="_Questionnaire.Questions.ElementAt(iCopy)" 
			OnQuestionDelete="DeleteQuestion">
		</QuestionComponent>
	}
</div>

<QuestionnaireCRUDButtonsPanelComponent OnNewQuestionAdd="AddNewQuestion"></QuestionnaireCRUDButtonsPanelComponent>

@code {
	[CascadingParameter]
	public Questionnaire _Questionnaire { get; set; }

	private void DeleteQuestion(string questionId)
	{
		var questionToRemove = _Questionnaire.Questions.Where(q => q.Id == questionId).First();

		if(questionToRemove != null)
		{
			_Questionnaire.Questions.Remove(questionToRemove);
		}
	}

	private void AddNewQuestion(QuestionType questionType)
	{
		switch (questionType)
		{
			case QuestionType.Text:
				_Questionnaire.Questions.Add(new QuestionText());
				break;

			case QuestionType.Checkbox:
				_Questionnaire.Questions.Add(new QuestionCheckbox());
				break;

			case QuestionType.IntRange:
				_Questionnaire.Questions.Add(new QuestionIntRange());
				break;

			case QuestionType.Select:
				_Questionnaire.Questions.Add(new QuestionSelect());
				break;

			case QuestionType.MultipleSelect:
				_Questionnaire.Questions.Add(new QuestionMultipleSelect());
				break;

			default:
				break;
		}
	}
}
